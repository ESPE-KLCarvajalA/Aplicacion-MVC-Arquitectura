<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <title>Editar Paciente</title>
</head>
<body>
  <h1>Editar Paciente</h1>
  <form action="/pacientes/<%= paciente._id %>?_method=PUT" method="POST">
    <input type="text" name="nombre" value="<%= paciente.nombre %>" required>
    <input type="text" name="apellido" value="<%= paciente.apellido %>" required>
    <input type="text" name="cedula" value="<%= paciente.cedula %>" required>
    <input type="email" name="email" value="<%= paciente.email %>">
    <input type="date" name="fechaNacimiento" value="<%= paciente.fechaNacimiento.toISOString().split('T')[0] %>" required>
    <button type="submit">Actualizar</button>
  </form>
  
</body>
</html>
