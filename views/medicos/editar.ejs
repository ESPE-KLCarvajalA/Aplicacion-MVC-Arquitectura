<h1>Editar Médico</h1>
<form action="/medicos/editar/<%= medico._id %>" method="POST">
  <input name="nombre" value="<%= medico.nombre %>" required><br>
  <input name="especialidad" value="<%= medico.especialidad %>" required><br>
  <input name="email" value="<%= medico.email %>"><br>
  <input name="telefono" value="<%= medico.telefono %>"><br>
  <button type="submit">Actualizar</button>
</form>
