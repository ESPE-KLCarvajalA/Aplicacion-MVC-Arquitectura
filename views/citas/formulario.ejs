<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <title><%= cita ? 'Editar Cita' : 'Agregar Cita' %></title>
</head>
<body>
  <h1><%= cita ? 'Editar Cita' : 'Agregar Cita' %></h1>

  <form action="<%= cita ? '/citas/' + cita._id + '?_method=PUT' : '/citas' %>" method="POST">
    <label>Paciente:</label>
    <select name="idPaciente" required>
      <% pacientes.forEach(p => { %>
        <option value="<%= p._id %>" <%= cita && cita.idPaciente.equals(p._id) ? 'selected' : '' %>>
          <%= p.nombre %> <%= p.apellido %>
        </option>
      <% }) %>
    </select><br><br>

    <label>Médico:</label>
    <select name="idMedico" required>
      <% medicos.forEach(m => { %>
        <option value="<%= m._id %>" <%= cita && cita.idMedico.equals(m._id) ? 'selected' : '' %>>
          <%= m.nombre %> - <%= m.especialidad %>
        </option>
      <% }) %>
    </select><br><br>

    <label>Fecha y Hora:</label>
    <input type="datetime-local" name="fechaHora" required
      value="<%= cita ? new Date(cita.fechaHora).toISOString().slice(0,16) : '' %>"><br><br>

    <label>Motivo:</label>
    <input type="text" name="motivo" value="<%= cita ? cita.motivo : '' %>"><br><br>

    <button type="submit"><%= cita ? 'Actualizar' : 'Guardar' %></button>
    <button type="button" onclick="window.location.href='/citas'">Cancelar</button>
  </form>
</body>
</html>
